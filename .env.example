# --- Core ---
NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL ---
# Local development (host): postgresql://usts:usts_dev_password@localhost:5432/usts_email
# Inside Docker Compose the host is `postgres`, not localhost.
DATABASE_URL=postgresql://usts:usts_dev_password@localhost:5432/usts_email
POSTGRES_USER=usts
POSTGRES_PASSWORD=usts_dev_password
POSTGRES_DB=usts_email
POSTGRES_PORT=5432
N8N_DB=n8n

# --- Ports ---
BACKEND_PORT=4000
FRONTEND_PORT=5173
N8N_PORT=5678

# --- Sessions (REQUIRED, no default in production; >= 16 chars) ---
SESSION_SECRET=change-me-session-secret-please
SESSION_COOKIE_NAME=usts_sid
FRONTEND_ORIGIN=http://localhost:5173

# --- n8n (REQUIRED shared secret between n8n and the backend; >= 16 chars) ---
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=change-me-webhook-secret-please
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
# Outbound webhook URLs the backend calls on n8n (leave empty in demo mode)
N8N_SYNC_WEBHOOK_URL=
N8N_CLASSIFICATION_WEBHOOK_URL=
N8N_SEND_REPLY_WEBHOOK_URL=

# --- AI provider ---
# provider: `mock` (deterministic, no key needed — demo/tests) or `groq`
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1

# --- Gmail (filled only when connecting a real test mailbox) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5678/rest/oauth2-credential/callback

# --- Application mailbox identity ---
MAILBOX_ADDRESS=demo@example.com

# --- Frontend ---
# Vite dev-server proxy target for /api (see apps/frontend/vite.config.js)
VITE_API_PROXY_TARGET=http://localhost:4000
