# --- Core ---
NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL ---
# Local development (host): postgresql://usts:usts_dev_password@localhost:5432/usts_email
# Inside Docker Compose the host is `postgres`, not localhost.
DATABASE_URL=postgresql://usts:usts_dev_password@localhost:5432/usts_email
POSTGRES_USER=usts
POSTGRES_PASSWORD=usts_dev_password
POSTGRES_DB=usts_email
POSTGRES_PORT=5432
N8N_DB=n8n

# --- Ports ---
BACKEND_PORT=4000
FRONTEND_PORT=5173
N8N_PORT=5678
# Local demo mailbox (GreenMail) host ports
GREENMAIL_SMTP_PORT=3025
GREENMAIL_IMAP_PORT=3143
GREENMAIL_API_PORT=8080

# --- Docker DNS ---
# Fedora + Docker may pin the daemon to unreachable public resolvers. Containers
# then cannot resolve imap.gmail.com/smtp.gmail.com (EAI_AGAIN). Set this to the
# LAN DNS used by the host, or configure the daemon to use 172.17.0.1 with
# DNSStubListenerExtra=172.17.0.1 (durable fix).
DOCKER_DNS=10.46.41.52

# --- Sessions (REQUIRED, no default in production; >= 16 chars) ---
SESSION_SECRET=change-me-session-secret-please
SESSION_COOKIE_NAME=usts_sid
FRONTEND_ORIGIN=http://localhost:5173

# --- n8n (REQUIRED shared secret between n8n and the backend; >= 16 chars) ---
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=change-me-webhook-secret-please
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
# Outbound webhook URLs the backend calls on n8n
N8N_SYNC_WEBHOOK_URL=
N8N_CLASSIFICATION_WEBHOOK_URL=
N8N_SEND_REPLY_WEBHOOK_URL=http://n8n:5678/webhook/send-reply

# --- AI provider ---
# provider: `mock` (deterministic, no key needed — demo/tests) or `groq`
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1

# --- Mailbox mode ---
# `local` = GreenMail demo mailbox (no secret, default).
# `gmail` = real Gmail App Password (fill the Gmail section below).
MAIL_MODE=local

# --- Gmail (optional; the default local demo mailbox needs no secret) ---
# The stack ships a local GreenMail demo mailbox: demo@example.com / demo1234.
# To use a real Gmail account instead, set MAIL_MODE=gmail, create an App
# Password at https://myaccount.google.com/apppasswords (2-Step Verification
# required), set MAILBOX_ADDRESS to that Gmail address and fill
# GMAIL_APP_PASSWORD.
GMAIL_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
# Optional OAuth2 values (legacy; the shipped workflows use App Password)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5678/rest/oauth2-credential/callback

# --- Application mailbox identity ---
# demo@example.com maps to the local GreenMail mailbox. For Gmail mode, set
# this to the Gmail address that owns GMAIL_APP_PASSWORD.
MAILBOX_ADDRESS=demo@example.com

# --- Frontend ---
# Vite dev-server proxy target for /api (see apps/frontend/vite.config.js)
VITE_API_PROXY_TARGET=http://localhost:4000
